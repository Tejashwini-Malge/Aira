# Secrets — never commit real keys
.env
*.env
!.env.example
google_creds.json

# Feedback exports — contain user emails/free text, never commit
feedback_export_*.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Local data / generated artifacts
backend/reports/
backend/*.db
# Flask's auto-created instance folder — a relative sqlite:/// URI lands here,
# so any local script pointed at SQLite drops a stray database into the repo.
backend/instance/
backend/answers.json
backend/persona.json
*.log

# OS / editor
.DS_Store
Thumbs.db
